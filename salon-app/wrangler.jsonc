{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skynn-soul-salon",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "GITHUB_OWNER": "SreenivasPulikonda",
    "GITHUB_REPO": "skynn-soul-private-data",
    "GITHUB_BRANCH": "main",
    "OWNER_NAME": "Salon owner",
    "MANAGER_NAME": "Salon manager",
    "SESSION_EPOCH": "1"
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "71001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "71002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "limits": {
    "cpu_ms": 30000
  }
}
